{
  "manifest_version": 3,
  "name": "AutoReply WhatsApp Bridge",
  "version": "2.1.0",
  "description": "Connects WhatsApp Web to the local AutoReply desktop app without screen coordinates.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "AutoReply WhatsApp Bridge"
  }
}
